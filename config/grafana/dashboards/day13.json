{
  "uid": "day13-llmops",
  "title": "K4-L3B Day 13 Monitoring & LLMOps",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-60m",
    "to": "now"
  },
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "title": "Latency percentiles and TTFT",
      "type": "stat",
      "description": "Source: data/logs.jsonl. Window aggregation. Threshold: p95 lte 3000. event == \"response_sent\" | percentile(latency_ms, [50, 95, 99]); percentile(ttft_ms, [95])",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 10
      },
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "day13-logs"
      },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "url",
          "parser": "uql",
          "uql": "parse-json",
          "url": "http://127.0.0.1:8000/dashboard/latency?start=${__from}&end=${__to}",
          "url_options": {
            "method": "GET",
            "data": ""
          },
          "root_selector": "",
          "columns": []
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 3000
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 2,
      "title": "Request traffic",
      "type": "timeseries",
      "description": "Source: data/logs.jsonl. Window aggregation. Threshold: rate_per_minute gte 1. event == \"request_received\" | count() by 1m",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 10
      },
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "day13-logs"
      },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "url",
          "parser": "uql",
          "uql": "parse-json",
          "url": "http://127.0.0.1:8000/dashboard/traffic?start=${__from}&end=${__to}",
          "url_options": {
            "method": "GET",
            "data": ""
          },
          "root_selector": "",
          "columns": [
            {
              "selector": "time",
              "text": "Time",
              "type": "timestamp_epoch"
            },
            {
              "selector": "requests_per_minute",
              "text": "Requests/min",
              "type": "number"
            },
            {
              "selector": "request_count",
              "text": "Window request count",
              "type": "number"
            }
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqpm",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            },
            "drawStyle": "line",
            "showPoints": "always"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Window request count"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "title": "Error rate and retrieval success",
      "type": "stat",
      "description": "Source: data/logs.jsonl. Window aggregation. Threshold: error_rate_pct lte 2. Retrieval denominator includes successful responses and failed retrieval attempts. Error counts use requests as denominator.",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 10
      },
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "day13-logs"
      },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "url",
          "parser": "uql",
          "uql": "parse-json",
          "url": "http://127.0.0.1:8000/dashboard/errors?start=${__from}&end=${__to}",
          "url_options": {
            "method": "GET",
            "data": ""
          },
          "root_selector": "",
          "columns": []
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "retrieval_success_pct"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "green",
                      "value": 90
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^errors_"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 4,
      "title": "Cost over time",
      "type": "timeseries",
      "description": "Source: data/logs.jsonl. Window aggregation. Threshold: total lte 2.5. event == \"response_sent\" | sum(cost_usd) by 1m; sum(cost_usd)",
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 8,
        "h": 10
      },
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "day13-logs"
      },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "url",
          "parser": "uql",
          "uql": "parse-json",
          "url": "http://127.0.0.1:8000/dashboard/cost?start=${__from}&end=${__to}",
          "url_options": {
            "method": "GET",
            "data": ""
          },
          "root_selector": "",
          "columns": [
            {
              "selector": "time",
              "text": "Time",
              "type": "timestamp_epoch"
            },
            {
              "selector": "cost_usd",
              "text": "Cost/min",
              "type": "number"
            },
            {
              "selector": "total_usd",
              "text": "Window total USD",
              "type": "number"
            }
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 2.5
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            },
            "drawStyle": "line",
            "showPoints": "always"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "title": "Input and output tokens",
      "type": "stat",
      "description": "Source: data/logs.jsonl. Window aggregation. Threshold: sum_by_field lte 50000. event == \"response_sent\" | sum(tokens_in), sum(tokens_out)",
      "gridPos": {
        "x": 8,
        "y": 10,
        "w": 8,
        "h": 10
      },
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "day13-logs"
      },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "url",
          "parser": "uql",
          "uql": "parse-json",
          "url": "http://127.0.0.1:8000/dashboard/tokens?start=${__from}&end=${__to}",
          "url_options": {
            "method": "GET",
            "data": ""
          },
          "root_selector": "",
          "columns": []
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 50000
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 6,
      "title": "Quality proxy",
      "type": "stat",
      "description": "Source: data/logs.jsonl. Window aggregation. Threshold: mean gte 0.75. event == \"response_sent\" | mean(quality_score)",
      "gridPos": {
        "x": 16,
        "y": 10,
        "w": 8,
        "h": 10
      },
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "day13-logs"
      },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "url",
          "parser": "uql",
          "uql": "parse-json",
          "url": "http://127.0.0.1:8000/dashboard/quality?start=${__from}&end=${__to}",
          "url_options": {
            "method": "GET",
            "data": ""
          },
          "root_selector": "",
          "columns": []
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.75
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name"
      }
    }
  ],
  "tags": [
    "CP2",
    "JSONL",
    "K4-L3B"
  ]
}
